# Ignore transient per-run outputs; curated HDF5/gathered results live under simulation/results.
simulation/inputs/*.h5
simulation/inputs/*.out
simulation/inputs/*.log
__pycache__/
*.pyc
# Ignore uncurated smoke files created directly under simulation/.
simulation/current_model_*.h5
simulation/current_model_*.in
simulation/current_model_*.png
simulation/raster_scan/*/line_*/input*.h5
simulation/raster_scan/*/line_*/run.log
simulation/raster_scan/*/runner.log
simulation/raster_scan/*/runner.err.log
simulation/results/global_5mm/collector.log
simulation/results/global_5mm/collector.err.log
simulation/results/global_10mm/collector.log
simulation/results/global_10mm/collector.err.log
simulation/raster_scan/*/validation_line*.log
simulation/raster_scan/*/validation_line*.err.log
simulation/results/*/collector.log
simulation/results/*/collector.err.log
